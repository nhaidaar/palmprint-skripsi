# PalmGate runtime configuration

# production hides dev-only ROI/upload tools. Use development on laptops while testing.
APP_ENV=production

# Recognition threshold. The fixed default is 0.75.
SIMILARITY_THRESHOLD=0.75

# Duplicate registration threshold. Defaults to SIMILARITY_THRESHOLD when unset.
# DUPLICATE_THRESHOLD=0.75

# Docker Compose defaults to USB mode after copying this file to .env.
COMPOSE_PROFILES=usb
PALMGATE_IMAGE=ghcr.io/nhaidaar/palmprint-be:latest
PALMGATE_FRONTEND_IMAGE=ghcr.io/nhaidaar/palmprint-fe:latest

# Two distinct host capture devices. Use /dev/v4l/by-path/... to bind roles to USB ports,
# or /dev/v4l/by-id/... to bind roles to cameras with unique serial numbers.
# Compose maps these to /dev/video0 (ENTRY) and /dev/video2 (EXIT) inside the container.
ENTRY_CAMERA_DEVICE_PATH=/dev/video0
EXIT_CAMERA_DEVICE_PATH=/dev/video2

# Door lock relay. Include docker-compose.gpio.yml to enable and map GPIO in Docker.
# Orange Pi Zero 3 header pin 12 (PC11) is line 75 on /dev/gpiochip0;
# verify the chip and line with gpioinfo on the board's OS.
LOCK_GPIO_ENABLED=0
LOCK_GPIO_CHIP=/dev/gpiochip0
LOCK_GPIO_LINE=75
LOCK_ACTIVE_LOW=1
LOCK_UNLOCK_MS=2000

# Runtime mode (Use DEVICE_RUNTIME_ENABLED=0 and CAMERA_SOURCE=browser for browser mode)
DEVICE_RUNTIME_ENABLED=1
CAMERA_SOURCE=usb

# Database
DB_PATH=palmprint.db

# Cloudflare Tunnel (Domain)
CLOUDFLARE_TUNNEL_TOKEN=
